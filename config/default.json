  "judge": {
    "timeoutMs": 6000,
    "maxOutputBytes": 16384,
    "maxMemoryMb": 256,
    "useNodePermissionModel": true,
    "tmpRoot": "",
    "failPatterns": [
      "AssertionError",
      "^not ok \\d+"
    ],
    "dropOutputLinePatterns": [
      "^\\s+at .*\\(?node:internal/",
      "^\\s+at (Module|Function|Object)\\.[\\w.<>]+ \\(node:",
      "^node:(assert|internal)[\\w/.:]*$",
      "^\\s+throw new AssertionError\\(obj\\);$",
      "^\\s+\\^$",
      "^Node\\.js v\\d+"
    ],
    "markerBytes": 16
  },
  "gate": {
    "minImprovement": 0.025,
    "tolerance": 0.025,
    "baselineRuns": 2,
    "maxPendingRuns": 3,
